# Copy to `.env` for local development. `.env` is git-ignored: never commit it.
# In production, set these in the Cloudflare dashboard (Settings -> Variables).
# Mark the server-side ones as "Secret".

# --- Public (safe in the browser, inlined at build time) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (SECRETS, never prefix with VITE_) ---
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sender for HyperHub emails; the domain must be verified in Resend.
# Example: HDP HyperHub <hyperhub@your-verified-domain.com>
MAIL_FROM=

# Optional: defaults to VITE_SUPABASE_URL
SUPABASE_URL=

# Build target on Cloudflare Pages
NITRO_PRESET=cloudflare-pages
